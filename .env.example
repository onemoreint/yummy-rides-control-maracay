# Copie este archivo como .env.local y complete los valores de su proyecto Supabase.
# Estas dos claves son PÚBLICAS por diseño (la seguridad la dan RLS y Auth).
# NUNCA coloque aquí la clave service_role.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Ruta base del sitio. "/" en desarrollo; "/yummy-rides-control-maracay/" en GitHub Pages.
VITE_BASE_PATH=/
